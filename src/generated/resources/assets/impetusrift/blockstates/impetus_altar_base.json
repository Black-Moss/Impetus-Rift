        "facing": "down"
      }
    },
    {
      "apply": {
        "model": "impetusrift:block/impetus_altar_base_cell",
        "y": 180
      },
      "when": {
        "cell_south": "true",
        "facing": "up"
      }
    },
    {
      "apply": {
        "model": "impetusrift:block/impetus_altar_base_cell",
        "x": 180
      },
      "when": {
        "cell_south": "true",
